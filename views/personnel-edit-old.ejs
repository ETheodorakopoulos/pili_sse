  </main>
  <script>
function previewPhoto(event) {
  const input = event.target;
  const preview = document.getElementById('photoPreview');
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = function(e) {
      preview.src = e.target.result;
      preview.style.display = 'block';
    };
    reader.readAsDataURL(input.files[0]);
  } else {
    preview.src = '';
    preview.style.display = 'none';
  }
}
</script>
<script>
  function setType(vehicle) {
      document.getElementById('vehicle').value = vehicle;
      document.getElementById('btn-motorcycle').classList.toggle('active', vehicle === 'motorcycle');
      document.getElementById('btn-car').classList.toggle('active', vehicle === 'car');
      if (vehicle ==='car'){
        document.getElementById('moto_brand_id').required = false;
        document.getElementById('car_brand_id').required = true;
        document.getElementById('moto_brand_label').classList.add('hide');
        document.getElementById('moto_brand_id').classList.add('hide');
        document.getElementById('car_brand_label').classList.remove('hide');
        document.getElementById('car_brand_id').classList.remove('hide');
      }else{
        document.getElementById('moto_brand_id').required = true;
        document.getElementById('car_brand_id').required = false;
        document.getElementById('moto_brand_label').classList.remove('hide');
        document.getElementById('moto_brand_id').classList.remove('hide');
        document.getElementById('car_brand_label').classList.add('hide');
        document.getElementById('car_brand_id').classList.add('hide');
      }
      //document.getElementById('plate_number').focus();
    }
    
</script>
<script>
     $('#car_brand_id').on('change', function() {
      $('#brand').val($(this).val());
    }).trigger('change');

    $('#moto_brand_id').on('change', function() {
      $('#brand').val($(this).val());
    }).trigger('change');
</script>
</body>
</html>