<!DOCTYPE html>
<html>
<head>
  <title>Manage Personnel — Facility Entrance</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/navbar.css">
</head>
<body>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script>function clearForm(formId) {
    const $form = $('#' + formId);
    $form[0].reset();
    $form.find('select').prop('selectedIndex', 0);
    $form.find('img[id$="Preview"]').attr('src', '').hide();
}</script>
<%- include('partial/navbar', { user: user, active: 'personnel' }) %>
  <main class="container">
    <h1>Manage Personnel</h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (success) { %><script>clearForm("personnelForm");</script> <% } %>

    <!-- Create form -->
    <div class="card">
      <h2>Edit Personnel</h2>
      <form action="/personnel-edit" method="POST" id="personnelForm" enctype="multipart/form-data">
        <div class="form-group">
          <label for="rank">Rank</label>
          <select name="rank" id="rank_id" required>
          <option value="<%= persResult.rank %>" selected>Select a rank</option>
          <% ranks.forEach(function(rank) { %>
          <option value="<%= rank.rank %>"><%= rank.rank %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="full_name">Full Name</label>
          <input type="text" name="full_name" value="<%= persResult.full_name %>" required>
        </div>
        <div class="form-group">
          <label for="am">AM</label>
          <input type="text" name="am" value="<%= persResult.am %>" required>
        </div>
        <div class="form-group">
          <label>Card Number</label>
          <input type="text" name="card_number" value="<%= persResult.card_number %>" required>
        </div>
        <div class="form-group vehicle-div">
          <label>Vehicle Type</label>
          <div class="direction-toggle">
         <input type="hidden" name="vehicle" id="vehicle" value="car">
          <button type="button" id="btn-car" class="btn btn-direction active" onclick="setType('car')" style="width: 30%; margin: 10%; font-size:55px">
        🚗</button>
        <button type="button" id="btn-motorcycle" class="btn btn-direction" onclick="setType('motorcycle')" style="width: 30%; margin: 10%; font-size:55px">
        🏍️</button>
        </div>
        </div>
        <div class="form-group" id="veh-brand-div">
          <input type="hidden" name="brand" id="brand">
          <label for="car_brand" id="car_brand_label">Car Brand</label>
          <select name="car_brand" id="car_brand_id" required>
          <option value="" disabled selected>Select a brand</option>
          <% car_brands.forEach(function(car_brand) { %>
          <option value="<%= car_brand.name %>"><%= car_brand.name %></option><% }) %>
          </select>
          <label for="moto_brand" class="hide" id="moto_brand_label">Motorcycle Brand</label>
          <select name="moto_brand" id="moto_brand_id" class="hide">
          <option value="" disabled selected>Select a brand</option>
          <% moto_brands.forEach(function(moto_brand) { %>
          <option value="<%= moto_brand.name %>"><%= moto_brand.name %></option><% }) %>
          </select>
        </div>
        <div class="form-group vehicle-div" >
          <label for="plate_number">Vehicle Plate Number</label>
          <input type="text" name="plate_number" id="plate_number" required>
        </div>
        <div class="form-group vehicle-div">
          <label for="color">Vehicle Color</label>
          <select name="color" id="color_id" required>
          <option value="" disabled selected>Select a color</option>
          <% colors.forEach(function(color) { %>
          <option value="<%= color.name %>"><%= color.name %></option><% }) %>
          </select>
        </div>
        <div class="form-group vehicle-div">
          <button type="submit" class="btn btn-primary btn-block">Create Personnel</button>
        </div>
        <div class="form-group">
          <label for="unit">Unit</label>
          <select name="unit" id="unit_id" required>
          <option value="" disabled selected>Select a unit</option>
          <option value="ΣΣΕ/ΕΠΙΤΕΛΕΙΟ">ΣΣΕ/ΕΠΙΤΕΛΕΙΟ</option>
          <option value="ΣΣΕ/ΣΥΝΤΑΓΜΑ">ΣΣΕ/ΣΥΝΤΑΓΜΑ</option>
          <option value="ΣΣΕ/ΛΔ">ΣΣΕ/ΛΔ</option>
          <option value="ΚΕΤΑΚ">ΚΕΤΑΚ</option></select>
        </div>
        <div class="form-group">
          <label for="photo">Photo</label>
          <input type="file" name="photo" id="photo" accept="image/*" onchange="previewPhoto(event)">
          <img id="photoPreview" src="" alt="" style="display:none; width:150px; height:150px; object-fit:cover; border-radius:8px; border:1px solid #d0d4dc; margin-top:8px;">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Create Personnel</button>
      </form>
    </div>

