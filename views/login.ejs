<!DOCTYPE html>
<html>
<head>
  <title><%= __('Login') %> — <%=__('Facility Entrance') %></title>
  <link rel="icon" href="/photos/icon.png">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
  <div class="auth-card">
    <div class="lang-switch">
  <a href="/set-language/el" class="<%= locale === 'en' ? 'active' : '' %>"><img src="/photos/greece.png"/></a>
  <a href="/set-language/en" class="<%= locale === 'el' ? 'active' : '' %>" style="margin-right: 15px;"><img src="/photos/united-states.png"/></a>
  </div>
    <img id="login-logo" src="/photos/icon.png">
    <h1> <%= __('Facility Entrance') %></h1>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form action="/login" method="POST">
      <div class="form-group">
        <label><%= __('Username') %></label>
        <input type="text" name="username" required autofocus>
      </div>
      <div class="form-group">
        <label><%= __('Password') %></label>
        <input type="password" name="password" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block" style="text-align:center; margin:auto; display: block;"><%= __('Login') %></button>
    </form>
  </div>
</body>
</html>