  </main>
</body>
<script>
const lang = getCookie('lang');
const isGreek = lang;
// Select all elements with the class
const columns = document.querySelectorAll('.col-filter');

// Loop through each item and attach the event listener individually
columns.forEach((column) => {
  column.addEventListener('keyup', (event) => {
    filterTable();
  });
});

function getCookie(name) {
  const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
  return match ? decodeURIComponent(match[2]) : null;
}


function filterTable() {
  const table = document.querySelector('table tbody') || document.querySelector('table');
  const filters = {};
  document.querySelectorAll('.col-filter').forEach(input => {
    const col = parseInt(input.dataset.col);
    filters[col] = input.value.toLowerCase().trim();
    console.log(col);
  });

  const rows = document.querySelectorAll('table tbody tr');
  rows.forEach(row => {
    const cells = row.querySelectorAll('td');
    let visible = true;
    for (const [col, value] of Object.entries(filters)) {
      if (value && cells[col] && !cells[col].textContent.toLowerCase().includes(value)) {
        visible = false;
        break;
      }
    }
    row.style.display = visible ? '' : 'none';
  });
}

const statusFilter = document.getElementById('status-filter');
if (statusFilter) {
  statusFilter.addEventListener('change', filterTable2);
}

function filterTable2() {
  const filters = {};
  document.querySelectorAll('.col-filter').forEach(input => {
    const col = parseInt(input.dataset.col);
    filters[col] = input.value.toLowerCase().trim();
  });


  let statusValue = statusFilter ? statusFilter.value : 'ALL';

  
  if (isGreek === 'el'){
      if (statusFilter.value === 'IN'){
        statusValue = 'εντός';
      }else if(statusFilter.value === 'OUT'){
         statusValue = 'εκτός';
      }else{
          statusValue = 'Όλα';
      }
      console.log(statusValue);
  }
      
  const STATUS_COL = 6; // index of the status <td> in each row

  const rows = document.querySelectorAll('table tbody tr');
  rows.forEach(row => {
    const cells = row.querySelectorAll('td');
    let visible = true;

    for (const [col, value] of Object.entries(filters)) {
      if (value && cells[col] && !cells[col].textContent.toLowerCase().includes(value.toLowerCase())) {
        visible = false;
        break;
      }
    }

    if (visible && (statusValue !== 'ALL' || statusValue !== 'Όλα')  && cells[STATUS_COL]) {
      const cellStatus = cells[STATUS_COL].textContent.trim().toLowerCase();
      console.log(cellStatus);
      if (cellStatus !== statusValue.toLowerCase()) visible = false;
    }

    row.style.display = visible ? '' : 'none';
  });
}

document.body.addEventListener('click', (event) => {
  const deleteButton = event.target.closest('.btn-delete');
  
  if (!deleteButton) return;

  const personnelId = deleteButton.dataset.id;

  if (isGreek === 'el'){
      if (confirm(`Είστε σίγουρος για τη διαγραφή;`)) {
        fetch(`/api/personnel/delete/${personnelId}`, {
        method: 'POST'
        })
        .then(res => {
          if (res.ok) {
          // SUCCESS: Find the matching row by its unique class and remove it
          deleteButton.closest('tr').remove();
          $('#success-msg').fadeIn(250);
          setTimeout(() => { $('#success-msg').trigger('focus');} , 255);
      } else {
          $('#error-msg').fadeIn(250);
          setTimeout(() => { $('#error-msg').trigger('focus');} , 255);
      }
    })
    .catch(err => console.error('Error during deletion:', err));
    }
  }
  else{
    if (confirm(`Are you sure you want to delete?`)) {
        fetch(`/api/personnel/delete/${personnelId}`, {
        method: 'POST'
      })
      .then(res => {
        if (res.ok) {
        // SUCCESS: Find the matching row by its unique class and remove it
          deleteButton.closest('tr').remove();
          $('#success-msg').fadeIn(250);
          setTimeout(() => { $('#success-msg').trigger('focus');} , 255);
      } else {
          $('#error-msg').fadeIn(250);
          setTimeout(() => { $('#error-msg').trigger('focus');} , 255);
      }
      })
      .catch(err => console.error('Error during deletion:', err));
    }
  }
})


// Handle Edit Buttons
document.querySelectorAll('.btn-edit').forEach(button => {
  button.addEventListener('click', (event) => {
    const personnelId = event.currentTarget.dataset.id;
    window.location.replace(`/personnel-edit/${personnelId}`);
    /* fetch(`/personnel-edit/${personnelId}`), {
      method: 'GET'
    }; */
  });
});


</script>
</html>