<!DOCTYPE html>
<html>
<head>
  <title><%= __('Manage Personnel') %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/navbar.css">
</head>
<body>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<%- include('partial/navbar', { user: user, active: 'personnel-status' }) %>

<main class="container" style="margin-left: 12%;">
    <h1><%= __('All Personnel Status') %></h1>

    <div id="error-msg" class="alert alert-error"><%= __('Failed to delete the record from the server.') %></div>
    <div id="success-msg" class="alert alert-success"><%= __('Person deleted successfully.') %></div>
    <table class="table">
        <thead>
          <tr>
            <th>
              <div class="col_header"><%= __('Rank') %></div>
              <input type="text" class="col-filter" data-col="0" style="min-width: 60px;" placeholder="Filter...">
            </th>
            <th>
              <div class="col_header"><%= __('Full Name') %></div>
              <input type="text" class="col-filter" data-col="1" style="min-width: 150px;" placeholder="Filter...">
            </th>
            <th>
              <div class="col_header"><%= __('Unit') %></div>
               <select name="unit" id="unit_id" class="col-filter" data-col="2" style="min-width: 125px;" required>
                <option value=""  selected><%= __('Select a unit') %></option>
                <% units.forEach(function(unit) { %>
                <option value="<%= unit.name %>"><%= unit.name %></option><% }) %>
              </select>
            </th>
            <th>
              <div class="col_header"><%= __('Card #') %></div>
              <input type="text" class="col-filter" data-col="3" placeholder="Filter...">
            </th>
            <th>
              <div class="col_header"><%= __('Plate #') %></div>
              <input type="text" class="col-filter" data-col="4" placeholder="Filter...">
            </th>
            <th>
              <div class="col_header"><%= __('Photo') %></div>
              <input type="text" class="col-filter" data-col="5" style="visibility: hidden;" placeholder="Filter...">
            </th>
            <th>
              <div class="col_header"><%= __('Status') %></div>
              <select id="status-filter" data-col="6">
                <option value="ALL" selected><%= __('ALL') %></option>
                <option value="IN"><%= __('IN') %></option>
                <option value="OUT"><%= __('OUT') %></option>
              </select>
            </th>
          </tr>
        </thead>
        <tbody>
          <% personnel.forEach(p => { %>
            <tr>
              <!-- <td><%= p.id || '—' %></td> -->
              <td><%= p.rank %></td>
              <td><%= p.full_name %></td>
              <td><%= p.unit || '—' %></td>
              <td><%= p.card_number || '—' %></td>
              <td style="min-width: 90px"><%= p.plate_number || '—' %></td>
              <td>
                <% if (p.photo) { %>
                <img src="/photos/<%= p.photo %>" alt="<%= p.full_name %>" style="width:100px; height:100px; object-fit:cover; border-radius:6px;">
                <% } else { %>
                <span class="empty">—</span>
                <% } %>
              </td>
              <td>
                <% if (p.vehicle_status === 'in') { %><span class="badge badge-in"><%= __('IN') %></span><% }
                   else { %><span class="badge badge-out"><%= __('OUT') %></span><% } %>
              </td>
              
    
              <td><button type="button" class="btn btn-edit" data-id="<%= p.id %>" <% if (user.role != 'admin') { %> disabled <% } %>>✏️<strong><%= __('Edit') %></strong></button></td>
              <td><button type="button" class="btn btn-delete" data-id="<%= p.id %>" <% if (user.role != 'admin') { %> disabled <% } %>>❌<strong><%= __('Delete') %></strong></button></td>
            </tr>
          <% }); %>
          <% if (personnel.length === 0) { %>
            <tr><td colspan="7" class="empty"><%= __('No personnel yet') %></td></tr>
          <% } %>
        </tbody>
      </table>
       <!-- Personnel list 
