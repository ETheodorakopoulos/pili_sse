<!DOCTYPE html>
<html>
<head>
  <title><%= __('Add New Personnel') %> — <%= __('Facility Entrance') %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/navbar.css">
  
</head>
<body>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script>function clearForm(formId) {
    const $form = $('#' + formId);
    $form[0].reset();
    $form.find('select').prop('selectedIndex', 0);
    $form.find('img[id$="Preview"]').attr('src', '').hide();
}</script>
<%- include('partial/navbar', { user: user, active: 'personnel' }) %>
  <main class="container">
    <h1><%= __('Add New Personnel') %></h1>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
    <% if (success) { %><script>clearForm("personnelForm");</script> <% } %>

    <!-- Create form -->
    <div class="card">
      <form action="/personnel" method="POST" id="personnelForm" enctype="multipart/form-data">
        <div class="form-group">
          <label for="rank"><%= __('Rank') %></label>
          <select name="rank" id="rank_id" required>
          <option value="" disabled selected><%= __('Select a rank') %></option>
          <% ranks.forEach(function(rank) { %>
          <option value="<%= rank.rank %>"><%= rank.rank %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="full_name"><%= __('Full Name') %></label>
          <input type="text" name="full_name" required>
        </div>
        <div class="form-group">
          <label for="am"><%= __('AM') %></label>
          <input type="text" name="am" required>
        </div>
        <div class="form-group">
          <label><%= __('Card Number') %></label>
          <input type="text" name="card_number" required>
        </div>
        <div class="form-group">
          <label><%= __('Vehicle Type') %></label>
          <div class="direction-toggle">
         <input type="hidden" name="vehicle" id="vehicle" value="car">
          <button type="button" id="btn-car" class="btn btn-direction active" title="Car" style="width: 30%; margin: 5%; font-size:55px">
        🚗</button>
        <button type="button" id="btn-motorcycle" class="btn btn-direction" title="Motorcycle" style="width: 30%; margin: 5%; font-size:55px">
        🏍️</button>
        </div>
        </div>
        <div class="form-group">
          <input type="hidden" name="brand" id="brand">
          <label for="car_brand" id="car_brand_label"><%= __('Car Brand') %></label>
          <select name="car_brand" id="car_brand_id" required>
          <option value="" disabled selected><%= __('Select a brand') %></option>
          <% car_brands.forEach(function(car_brand) { %>
          <option value="<%= car_brand.name %>"><%= car_brand.name %></option><% }) %>
          </select>
          <label for="moto_brand" class="hide" id="moto_brand_label"><%= __('Motorcycle Brand') %></label>
          <select name="moto_brand" id="moto_brand_id" class="hide">
          <option value="" disabled selected><%= __('Select a brand') %></option>
          <% moto_brands.forEach(function(moto_brand) { %>
          <option value="<%= moto_brand.name %>"><%= moto_brand.name %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="plate_number"><%= __('Vehicle Plate Number') %></label>
          <input type="text" name="plate_number" id="plate_number" placeholder="ABZ 1234" required>
        </div>
        <div class="form-group">
          <label for="color"><%= __('Vehicle Color') %></label>
          <select name="color" id="color_id" required>
          <option value="" disabled selected><%= __('Select a color') %></option>
          <% colors.forEach(function(color) { %>
          <option value="<%= color.name %>"><%= color.name %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="unit"><%= __('Unit') %></label>
          <select name="unit" id="unit_id" required>
            <option value="" disabled selected><%= __('Select a unit') %></option>
          <% units.forEach(function(unit) { %>
          <option value="<%= unit.name %>"><%= unit.name %></option><% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="photo"><%= __('Photo') %></label>
          <input type="file" name="photo" id="photo" accept="image/*">
          <img id="photoPreview" src="" alt="" style="display:none; width:150px; height:150px; object-fit:cover; border-radius:8px; border:1px solid #d0d4dc; margin-top:8px;">
        </div>
        <button type="submit" id="btn_create_pers" class="btn btn-primary btn-block"><%= __('Submit') %></button>
      </form>
    </div>
  </main>
  <script>
const photoInput = document.getElementById('photo');
const photoPreview = document.getElementById('photoPreview');

if (photoInput) {
  photoInput.addEventListener('change', () => {
    if (photoInput.files && photoInput.files[0]) {
      const reader = new FileReader();
      reader.onload = (e) => {
        photoPreview.src = e.target.result;
        photoPreview.style.display = 'block';
      };
      reader.readAsDataURL(photoInput.files[0]);
    } else {
      photoPreview.src = '';
      photoPreview.style.display = 'none';
    }
  });
}
</script>
<script>
     $('#car_brand_id').on('change', function() {
      $('#brand').val($(this).val());
    }).trigger('change');

    $('#moto_brand_id').on('change', function() {
      $('#brand').val($(this).val());
    }).trigger('change');
</script>
<script>
const btnCar = document.getElementById('btn-car');
const carList = document.getElementById('car_brand_id');
const carLbl = document.getElementById('car_brand_label');
const btnMotor = document.getElementById('btn-motorcycle');
const motorLbl = document.getElementById('moto_brand_label');
const motorList = document.getElementById('moto_brand_id');
const veh = document.getElementById('vehicle');



  btnCar.addEventListener('click', () => {
      motorList.required = false;
      carList.required = true;
      motorLbl.classList.add('hide');
      motorList.classList.add('hide');
      carLbl.classList.remove('hide');
      carList.classList.remove('hide');
      veh.value = 'car';
      btnCar.classList.add('active');
      btnMotor.classList.remove('active');
    });

  btnMotor.addEventListener('click', () => {
      motorList.required = true;
      carList.required = false;
      motorLbl.classList.remove('hide');
      motorList.classList.remove('hide');
      carLbl.classList.add('hide');
      carList.classList.add('hide');
      veh.value = 'motorcycle';
      btnMotor.classList.add('active');
      btnCar.classList.remove('active');

  });


//document.getElementById('plate_number').focus();

</script>
</body>
</html>